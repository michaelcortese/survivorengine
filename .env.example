# Discord bot token (Bot -> Reset Token in the Developer Portal)
TOKEN=

# Your application's client ID (General Information -> Application ID)
CLIENT_ID=

# The guild (server) to register commands in. Guild commands update instantly;
# leave blank to register globally instead (takes up to an hour to propagate).
GUILD_ID=

# Optional: fixed RNG seed for reproducible shuffles while testing.
# SURVIVOR_RNG_SEED=12345

# Optional: set to false to post the tribe board as text only, with no picture.
# SURVIVOR_BOARD_IMAGES=true
