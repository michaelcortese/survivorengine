# Dependencies
node_modules/

# Build artifacts
dist/
build/
coverage/
*.tsbuildinfo

# Environment / secrets
.env
.env.local
.env.*.local
config.json

# Saved game state. These files contain real Discord snowflakes (user and channel ids) and
# must never be committed. `*.bin`/`saves/` are the OLD format's names; `.survivor-state/` is
# `config.autosave.directory`, which SURVIVOR_STATE_DIR can point anywhere — hence the glob.
# Audit #105: live snapshots with real user IDs sat untracked at the repo root, uncovered.
*.bin
saves/
.survivor-state/
*.survivor-state*/
*.survivor-state*

# Logs
logs/
*.log
npm-debug.log*

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
